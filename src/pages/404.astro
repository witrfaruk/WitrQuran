---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | WITRQURAN"
  description="The page you are looking for does not exist or has been moved."
  noindex={true}
>
  <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 60vh; text-align: center; padding: 2rem;">
    <h1 style="font-size: 6rem; font-weight: 700; color: var(--emerald-bright); margin-bottom: 1rem;">404</h1>
    <h2 style="font-size: 2rem; font-weight: 500; color: #ffffff; margin-bottom: 1rem;">Page Not Found</h2>
    <p style="font-size: 1.1rem; color: var(--muted); margin-bottom: 2rem; max-width: 400px;">
      The page you are looking for doesn't exist or has been moved.
    </p>
    <a href="/" class="btn-primary">
      <span>Return Home</span>
    </a>
  </div>
</Layout>
