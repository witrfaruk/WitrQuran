---
import Layout from '../layouts/Layout.astro';
import PopularSurahCard from '../components/ui/PopularSurahCard';
import SurahGridCard from '../components/ui/SurahGridCard';
import surahsData from '../data/surahs.json';
import styles from '../styles/page.module.css';

// 6 Popular Surahs
const popularSurahsList = [
  { id: 1, slug: 'al-fatihah', arabicName: 'الفَاتِحَة', transliteration: 'Al-Fatihah', imageSrc: '/popular-surahs/1.jpg' },
  { id: 2, slug: 'al-baqarah', arabicName: 'البَقَرَة', transliteration: 'Al-Baqarah', imageSrc: '/popular-surahs/2.jpg' },
  { id: 3, slug: 'ali-imran', arabicName: 'آلِ عِمْرَان', transliteration: 'Al-Imran', imageSrc: '/popular-surahs/3.jpg' },
  { id: 4, slug: 'an-nisa', arabicName: 'النِّسَاء', transliteration: 'An-Nisa', imageSrc: '/popular-surahs/4.jpg' },
  { id: 5, slug: 'al-maidah', arabicName: 'المَائِدَة', transliteration: 'Al-Ma\'idah', imageSrc: '/popular-surahs/5.jpg' },
  { id: 10, slug: 'yunus', arabicName: 'يُونُس', transliteration: 'Yunus', imageSrc: '/popular-surahs/6.jpg' },
];

// First 10 Surahs for the All Surahs highlights
const firstTenSurahs = surahsData.slice(0, 10).map((s) => {
  let formattedArabic = s.arabicName;
  if (s.id === 1) formattedArabic = 'الفَاتِحَة';
  if (s.id === 2) formattedArabic = 'البَقَرَة';
  if (s.id === 3) formattedArabic = 'آلِ عِمْرَان';
  if (s.id === 4) formattedArabic = 'النِّسَاء';
  if (s.id === 5) formattedArabic = 'المَائِدَة';
  if (s.id === 6) formattedArabic = 'الأَنْعَام';
  if (s.id === 7) formattedArabic = 'الأَعْرَاف';
  if (s.id === 8) formattedArabic = 'الأَنْفَال';
  if (s.id === 9) formattedArabic = 'التَّوْبَة';
  if (s.id === 10) formattedArabic = 'يُونُس';

  let formattedTransliteration = s.transliteration;
  if (s.id === 3) formattedTransliteration = 'Al-Imran';
  if (s.id === 5) formattedTransliteration = 'Al-Ma\'idah';
  if (s.id === 6) formattedTransliteration = 'Al-An\'am';
  if (s.id === 7) formattedTransliteration = 'Al-A\'raf';

  return {
    ...s,
    arabicName: formattedArabic,
    transliteration: formattedTransliteration,
  };
});
---

<Layout
  title="WITRQURAN - Free Online Quran Listening"
  description="Listen to the Holy Quran online for free. Premium, distraction-free audio experience with 114 Surahs. No registration, no ads, completely free forever."
>
  <div class={styles.pageContainer}>
    {/* 1. HERO SECTION (2-Column Block Layout) */}
    <section class={styles.heroSection}>
      <div class="container">
        <div class={styles.heroGrid}>
          {/* Left: Headline & Actions */}
          <div class={styles.heroContent}>
            <div class={styles.heroBadge}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L14.5 5.5L19 4L18 8.5L22 11L18.5 13.5L20 18L15.5 17L13 21L10.5 17.5L6 19L7 14.5L3 12L6.5 9.5L5 5L9.5 6L12 2Z" stroke="var(--emerald)" />
              </svg>
              <span>114 Surahs • Distraction-Free Audio</span>
            </div>

            <h1 class={styles.heroTitle}>
              Experience<br />
              <span class={styles.heroAccent}>The Holy Quran</span>
            </h1>

            <p class={styles.heroSubtitle}>
              Listen to the words of Allah with absolute clarity and tranquility.
              Recited by Sheikh Mahmoud Khalil Al-Hussary, completely free and ad-free forever.
            </p>

            <div class={styles.heroButtonRow}>
              <a href="/surahs" class="btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span>Start Listening</span>
              </a>
              <a href="#popular-surahs" class="btn-secondary">
                <span>Explore Surahs</span>
              </a>
            </div>

            <div class={styles.heroTrustRow}>
              <div class={styles.trustItem}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>114 Full Surahs</span>
              </div>
              <div class={styles.trustItem}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>100% Free & Ad-Free</span>
              </div>
            </div>
          </div>

          {/* Right: 2x2 Block Card Showcase */}
          <div class={styles.heroShowcaseWrapper}>
            <div class={styles.showcaseGrid}>
              <div>
                <SurahGridCard
                  client:load
                  id={1}
                  arabicName="الفَاتِحَة"
                  transliteration="Al-Fatihah"
                />
                <div style="margin-top: 1.25rem;">
                  <SurahGridCard
                    client:load
                    id={2}
                    arabicName="البَقَرَة"
                    transliteration="Al-Baqarah"
                  />
                </div>
              </div>
              <div class={styles.showcaseColRight}>
                <SurahGridCard
                  client:load
                  id={36}
                  arabicName="يس"
                  transliteration="Ya-Sin"
                />
                <div style="margin-top: 1.25rem;">
                  <SurahGridCard
                    client:load
                    id={67}
                    arabicName="المُلْك"
                    transliteration="Al-Mulk"
                  />
                </div>
              </div>
            </div>

            {/* Overlapping Badge */}
            <div class={styles.showcaseBadge}>
              <div class={styles.badgeNumber}>114</div>
              <div class={styles.badgeLabel}>Surahs Complete</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 2. POPULAR SURAHS SECTION */}
    <section id="popular-surahs" class={styles.popularSection}>
      <div class="container">
        <div class={styles.sectionHeader}>
          <div class="divider">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
          </div>
          <h2 class={styles.sectionTitle}>Popular Surahs</h2>
          <p class={styles.sectionSubtitle}>Frequently listened and spiritually uplifting recitations</p>
        </div>

        <div class={styles.popularGrid}>
          {popularSurahsList.map((surah) => (
            <PopularSurahCard
              client:load
              key={surah.id}
              id={surah.id}
              slug={surah.slug}
              arabicName={surah.arabicName}
              transliteration={surah.transliteration}
              imageSrc={surah.imageSrc}
            />
          ))}
        </div>
      </div>
    </section>

    {/* 3. ALL SURAHS HIGHLIGHTS */}
    <section class={styles.allSurahsSection}>
      <div class="container">
        <div class={styles.sectionHeader}>
          <div class="divider">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          </div>
          <h2 class={styles.sectionTitle}>All Surahs</h2>
          <p class={styles.sectionSubtitle}>Browse the opening chapters of the Holy Quran</p>
        </div>

        <div class={styles.surahGrid}>
          {firstTenSurahs.map((surah) => (
            <SurahGridCard
              client:load
              key={surah.id}
              id={surah.id}
              arabicName={surah.arabicName}
              transliteration={surah.transliteration}
            />
          ))}
        </div>

        {/* View Full Catalog Button */}
        <div class={styles.viewAllWrapper}>
          <a href="/surahs" class="btn-secondary">
            <span>View Full Catalog (114 Surahs)</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

    {/* 4. MISSION / OUR STORY SECTION */}
    <section class={styles.missionSection}>
      <div class="container">
        <div class={styles.missionGrid}>
          {/* Standalone Quranic Verse & Reflection Block Card */}
          <div class={styles.missionCard}>
            <div class={styles.missionPatternOverlay}></div>

            <div class={styles.missionCardHeader}>
              <div class={styles.missionCardBadge}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                </svg>
                <span>Divine Guidance</span>
              </div>
              <div class={styles.missionCardSurahBadge}>17:9</div>
            </div>

            <div class={styles.missionArabicVerse}>
              إِنَّ هَٰذَا الْقُرْآنَ يَهْدِي لِلَّتِي هِيَ أَقْوَمُ
            </div>

            <div class={styles.quoteBox}>
              <svg class={styles.quoteIcon} width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path>
              </svg>
              <p class={styles.quoteText}>
                &ldquo;Indeed, this Quran guides to that which is most suitable and gives good tidings to the believers.&rdquo;
              </p>
              <div class={styles.quoteFooter}>
                <span class={styles.quoteRef}>Surah Al-Isra (17:9)</span>
                <span class={styles.quoteSub}>Sheikh Mahmoud Khalil Al-Hussary</span>
              </div>
            </div>
          </div>

          {/* Narrative & Stats Grid */}
          <div class={styles.missionContent}>
            <div class="divider" style="margin: 0 0 1rem 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
              </svg>
            </div>
            <h2 class={styles.missionTitle}>Our Mission</h2>
            <p class={styles.missionParagraph}>
              We provide WitrQuran 100% free and charge no money because we believe the Holy Quran is a divine gift of God to all humanity. We cannot charge money because we do not feel we have the right or ability to charge for the sacred words of Allah.
            </p>
            <p class={styles.missionParagraph}>
              WitrQuran is built as a pure, distraction-free sanctuary for listening to the Holy Quran online. Designed with love and devotion to provide instant access to the timeless recitation of Sheikh Mahmoud Khalil Al-Hussary without advertisements, paywalls, or subscriptions.
            </p>

            {/* 3-Box Stats Grid */}
            <div class={styles.statsGrid}>
              <div class={styles.statBox}>
                <div class={styles.statValue}>114</div>
                <div class={styles.statLabel}>Full Surahs</div>
              </div>
              <div class={styles.statBox}>
                <div class={styles.statValue}>0</div>
                <div class={styles.statLabel}>Ads / Trackers</div>
              </div>
              <div class={styles.statBox}>
                <div class={styles.statValue}>100%</div>
                <div class={styles.statLabel}>Free Forever</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 5. LISTENING EXPERIENCE FEATURES SECTION */}
    <section class={styles.featuresSection}>
      <div class="container">
        <div class={styles.sectionHeader}>
          <div class="divider">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
          </div>
          <h2 class={styles.sectionTitle}>Crafted for Pure Reflection</h2>
          <p class={styles.sectionSubtitle}>Thoughtful features designed for a seamless listening experience</p>
        </div>

        <div class={styles.featuresGrid}>
          {/* Feature 1 */}
          <div class={styles.featureCard}>
            <div class={styles.featureIconBox}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
              </svg>
            </div>
            <h3 class={styles.featureTitle}>High Quality Audio</h3>
            <p class={styles.featureDescription}>
              Pristine, high-fidelity recitation by Sheikh Mahmoud Khalil Al-Hussary.
            </p>
          </div>

          {/* Feature 2 */}
          <div class={styles.featureCard}>
            <div class={styles.featureIconBox}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </div>
            <h3 class={styles.featureTitle}>Background Playback</h3>
            <p class={styles.featureDescription}>
              Continuous playback with full lockscreen and system media controls.
            </p>
          </div>

          {/* Feature 3 */}
          <div class={styles.featureCard}>
            <div class={styles.featureIconBox}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3 class={styles.featureTitle}>Adjustable Speed</h3>
            <p class={styles.featureDescription}>
              Customize recitation pace from 0.75x to 2.0x for study and memorization.
            </p>
          </div>

          {/* Feature 4 */}
          <div class={styles.featureCard}>
            <div class={styles.featureIconBox}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
              </svg>
            </div>
            <h3 class={styles.featureTitle}>Sleep Timer</h3>
            <p class={styles.featureDescription}>
              Automatically stop playback after 15, 30, 60 minutes or end of Surah.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
